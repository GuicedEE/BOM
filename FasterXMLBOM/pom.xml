<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guicedee</groupId>
        <artifactId>versioner</artifactId>
        <version>2.3.0</version>
        <relativePath>../Versioner</relativePath>
    </parent>


    <groupId>com.guicedee</groupId>
    <artifactId>fasterxml-bom</artifactId>
    <version>2.3.0</version>

    <packaging>pom</packaging>

    <name>FasterXML BOM</name>
    <description>The BOM for FasterXML Artefacts</description>
    <url>https://guicedee.com</url>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/GuicedEE/BOM</url>
        <connection>scm:git:https://github.com/GuicedEE/BOM.git</connection>
        <developerConnection>scm:git:https://github.com/GuicedEE/BOM.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <id>GedMarc</id>
            <name>Marc Magon</name>
            <email>marc.magon@gmail.com</email>
            <url>https://github.com/GedMarc</url>
        </developer>
    </developers>

    <properties>
        <project.scm.nameUrl>/GuicedEE/BOM</project.scm.nameUrl>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <properties>remove</properties>
                        <dependencies>resolve</dependencies>
                        <dependencyManagement>resolve</dependencyManagement>
                    </pomElements>
                    <detail>true</detail>
                    <updatePomFile>true</updatePomFile>
                    <flattenedPomFilename>flatter.pom</flattenedPomFilename>
                </configuration>
                <executions>
                    <!-- enable flattening -->
                    <execution>
                        <id>flatten</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- ensure proper cleanup -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.woodstox</groupId>
                <artifactId>woodstox-core</artifactId>
                <version>${woodstox.version}</version>
            </dependency>

            <!--
         Import the Jackson 3 BOM FIRST, before any other import (notably
         vertx-stack-depchain / vertx-dependencies, which imports tools.jackson:jackson-bom
         at its own pinned Jackson 3 LTS). Maven dependencyManagement uses the FIRST
         declaration for a given GA, so importing it here makes ${jackson.version} the
         single source of truth for every tools.jackson.* artifact and for the Jackson 2.x
         com.fasterxml.jackson.core:jackson-annotations module it manages (JSTEP-1).
         Without this, standalone-bom silently resolved Jackson to the Vert.x pin while
         fasterxml-bom resolved ${jackson.version}, producing a split graph.
     -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson</groupId>
                        <artifactId>jackson-bom</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
